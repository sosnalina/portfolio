{#
  Two-block section pattern (e.g. "Tipping Point") — one section-subheader
  governs a section that spans two visual blocks (first block carries the
  subheader, second is a continuation with a different background). See
  CLAUDE.md: the subheader belongs to the whole section, not to each block.

  Params:
    title               — raw HTML for section-subheader__title
    subtitle            — raw HTML for section-subheader__subtitle
    firstParagraphs     — array of raw HTML strings for the first block's body
    secondParagraphs    — array of raw HTML strings for the second block's body
                           (ignored when called with {% call %} — see below)
    secondModifiers     — extra section-level classes for the second block (default: continuation bg)
    id                  — optional id attribute on the first block's outer <section>
    firstExtra          — optional raw HTML inserted after firstParagraphs, replacing
                           the first block's placeholder video (e.g. via a {% set %} capture)

  The second block defaults to body-paragraphs + a placeholder box. When a
  page's second block needs something else (real content doesn't always fit
  that shape — see case-studies/bill-pay/index.njk's Tipping Point section),
  call with {% call %} to replace the second block's entire inner content:

    {% call twoBlockSubheader(title, subtitle, firstParagraphs) %}
      ...anything...
    {% endcall %}
#}
{% from "shared/section.njk" import section %}
{% from "shared/section-body.njk" import sectionBody %}
{% macro twoBlockSubheader(title, subtitle, firstParagraphs, secondParagraphs=[], secondModifiers="section--green-light", id="", firstExtra="") %}
{% call section("", id) %}
<div class="section-subheader">
  <h2 class="section-subheader__title">{{ title | safe }}</h2>
  <p class="section-subheader__subtitle">{{ subtitle | safe }}</p>
</div>
{{ sectionBody(firstParagraphs) }}
{% if firstExtra %}
{{ firstExtra | safe }}
{% else %}
<div class="section-video section-video--placeholder"></div>
{% endif %}
{% endcall %}
{% call section(secondModifiers) %}
{% if caller %}
{{ caller() }}
{% else %}
{{ sectionBody(secondParagraphs) }}
<div class="section-video section-video--placeholder"></div>
{% endif %}
{% endcall %}
{% endmacro %}
