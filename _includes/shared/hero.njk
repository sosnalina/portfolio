{#
  Hero pattern.

  Params:
    headline         — raw HTML string for the visually-hidden h1 (the
                        scene variant draws the words itself; non-scene
                        callers still render this text visibly)
    subHeadline      — raw HTML string for the sub-headline paragraph
    id               — optional id attribute on the outer <section>
    scene            — when true, renders the Bill Pay hero-headline
                        scene layer (css/widgets/bill-pay/hero-headline/,
                        js/bill-pay/hero-headline.js) instead of a plain
                        static headline, and visually hides the h1 (the
                        scene draws the words in its place)

  Optional {% call %} block: content passed this way renders immediately
  after div.section-hero, still inside the hero's own section__slot. Plain
  expression calls (`{{ hero(...) }}`) are unaffected — `caller` is only
  truthy when invoked as `{% call hero(...) %}...{% endcall %}` (same guard
  pattern as two-block-header.njk).
#}
{% from "shared/section.njk" import section %}
{% macro hero(headline, subHeadline, id="", scene=false) %}
{% call section("section--hero section--green-light", id) %}
<div class="section-hero{% if scene %} section-hero--scene{% endif %}">
  <div class="section-hero__headline-stage">
    <h1 class="section-hero__headline">{{ headline | safe }}</h1>
    {% if scene %}<div class="hero-headline-scene" aria-hidden="true"></div>{% endif %}
  </div>
  <p class="section-hero__sub-headline">{{ subHeadline | safe }}</p>
</div>
{% if caller %}
{{ caller() }}
{% endif %}
{% endcall %}
{% endmacro %}
