<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    {% for href in stylesheets %}
    <link rel="stylesheet" href="{{ href }}" />
    {% endfor %}
  </head>
  <body>
    {% block body %}{% endblock %}
    {% for src in scripts %}
    <script src="{{ src }}"></script>
    {% endfor %}
  </body>
</html>
