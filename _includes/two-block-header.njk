{#
  Two-block section pattern with the BIG standard sectionHeader (as opposed
  to two-block-subheader.njk's small section-subheader) — one sectionHeader
  governs a section that spans two visual blocks (first block carries the
  header, second is a continuation with a different background). See
  CLAUDE.md: the header belongs to the whole section, not to each block.

  Params:
    heading             — raw HTML for sectionHeader's heading
    subheading          — raw HTML for sectionHeader's optional subheading (omit/empty for none)
    firstParagraphs     — array of raw HTML strings for the first block's body
    secondParagraphs    — array of raw HTML strings for the second block's body
                           (ignored when called with {% call %} — see below)
    secondModifiers     — extra section-level classes for the second block (default: continuation bg)
    id                  — optional id attribute on the first block's outer <section>
    firstExtra          — optional raw HTML inserted after firstParagraphs, replacing
                           the first block's placeholder video (e.g. via a {% set %} capture)

  The second block defaults to body-paragraphs + a placeholder box. When a
  page's second block needs something else (real content doesn't always fit
  that shape), call with {% call %} to replace the second block's entire
  inner content:

    {% call twoBlockHeader(heading, subheading, firstParagraphs) %}
      ...anything...
    {% endcall %}
#}
{% from "section.njk" import section %}
{% from "section-header.njk" import sectionHeader %}
{% from "section-body.njk" import sectionBody %}
{% macro twoBlockHeader(heading, subheading, firstParagraphs, secondParagraphs=[], secondModifiers="section--green-light", id="", firstExtra="") %}
{% call section("", id) %}
{{ sectionHeader(heading, subheading) }}
{{ sectionBody(firstParagraphs) }}
{% if firstExtra %}
{{ firstExtra | safe }}
{% else %}
<div class="section-video section-video--placeholder"></div>
{% endif %}
{% endcall %}
{% call section(secondModifiers) %}
{% if caller %}
{{ caller() }}
{% else %}
{{ sectionBody(secondParagraphs) }}
<div class="section-video section-video--placeholder"></div>
{% endif %}
{% endcall %}
{% endmacro %}
