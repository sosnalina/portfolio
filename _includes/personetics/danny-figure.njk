{#
  Danny figure + speech bubble — Personetics section 02 (spec: briefs/personetics/danny-figure.md §1).

  Params:
    lines — array of HTML-escaped strings from the `quote` visual of briefs/personetics/article-text.md,
            joined with <br> into one paragraph. An empty array fails the build.

  Markup renders the head mesh at t = 0 (dots at BASE). js/personetics/danny-figure.js animates it,
  reading dots and edges from the data-* attributes below.
#}
{% macro dannyFigure(lines) %}
{% set base = [[3,42],[113,3],[133,93],[90,119],[44,122],[68,42]] %}
{% set edges = [[0,1],[1,2],[2,3],[3,4],[4,0],[4,2],[1,3],[3,0],[4,5],[5,2],[1,5],[5,0]] %}
{% if not lines.length %}{{ dannyFigureMissingQuote() }}{% endif %}
<div class="dfg">
  <div class="dfg__bubble">{% include "personetics/danny-figure-bubble.svg" %}</div>
  <p class="dfg__quote">{{ lines | join("<br>") | safe }}</p>
  <div class="dfg__figure"><img class="dfg__strip" src="/assets/personetics/danny-figure/danny-leg-frames.webp" alt="" width="4606" height="821" decoding="async"></div>
  <div class="dfg__asterisk">{% include "personetics/danny-figure-asterisk.svg" %}</div>
  <svg class="dfg__lines" width="800" height="350" viewBox="0 0 800 350" aria-hidden="true">
    <g class="dfg__mesh" transform="matrix(0.99965 -0.02644 0.02644 0.99965 77 230) scale(1.3908)">
      {% for e in edges %}
      <line class="dfg__edge" data-edge="{{ loop.index0 }}" data-a="{{ e[0] }}" data-b="{{ e[1] }}" x1="{{ base[e[0]][0] }}" y1="{{ base[e[0]][1] }}" x2="{{ base[e[1]][0] }}" y2="{{ base[e[1]][1] }}" />
      {% endfor %}
      {% for b in base %}
      <circle class="dfg__dot" data-dot="{{ loop.index0 }}" cx="{{ b[0] }}" cy="{{ b[1] }}" r="3" />
      {% endfor %}
    </g>
  </svg>
</div>
{% endmacro %}
